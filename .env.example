# OpenAI-compatible model service
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Request resilience
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1

