  "supplementary_info": {
    "product_intro": {
      "product_name": "MPLS—VPN专线产品（简称MV产品）",
      "full_description": "MPLS-VPN是一种基于MPLS技术的IP VPN，是在网络路由和交换设备上应用MPLS（Multiprotocol Label Switching，多协议标记交换）技术，简化核心路由器的路由选择方式，利用结合传统路由技术的标记交换实现的IP 虚拟专用网络（IP VPN），可用来构造宽带的Intranet、Extranet，满足多种灵活的业务需求。",
      "application_scenarios": "在国际、国内有分支机构的集团公司、连锁企业等。涉及的行业有：保险业、家电/家居零售连锁店、大型集团公司、IT 企业、地产公司、国外驻华机构/代表处等。"
    },
    "product_keywords": {
      "raw_keywords": "点对点组网,本地组网,国内组网,线路延时,带宽利用率,是否具备资源,需要多长时间开通,使用人数,应用场景,需要多少带宽,打折,月租费,一次性费用,合同协议期,协议期内拆机违约金"
    },
