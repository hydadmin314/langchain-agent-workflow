  "supplementary_info": {
    "product_intro": {
      "product_name": "沃商务人才/酒店公寓",
      "full_description": "沃商务人才/酒店公寓是针对人才公寓、酒店公寓、公司厂区宿舍等市场推出的专项企业宽带接入产品。采用光纤到户的模式以经济实惠的价格为该类客户提供企业宽带和互联网电视服务。沃商务人才/酒店公寓一般由政府或企业开发，引进青年人才居住,目标并非注重盈利,而是表达一种“招贤纳士”的姿态,以收取良好的社会效益以及联动的经济吸引力。因此该产品主要面向政府和企业提供的沃商务人才/酒店公寓使用，不面向办公类经营类客户。",
      "application_scenarios": "（1）面向人才公寓、酒店式公寓、职工宿舍等公寓类市场 （2）采用FTTO+H七级标准地址接入，光纤预先到户 （3）该产品为接入层产品，上联到联通China169骨干网。 （4）批量接入宽带和沃企TV，价格经济实惠"
    },
    "product_keywords": {
      "raw_keywords": "酒店公寓宽带、人才公寓网络、长租公寓光纤、酒店客房一体化、沃企 TV、宾馆 IPTV、民宿专用宽带、宿舍批量宽带、公安网络安全审计、客房独立 WiFi、公寓整栋布线、酒店融合网关、职工宿舍宽带"
    },
